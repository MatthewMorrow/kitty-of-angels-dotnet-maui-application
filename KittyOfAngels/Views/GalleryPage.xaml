<?xml version="1.0" encoding="utf-8" ?>
<!--Version 1.0-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KittyOfAngels.Views.GalleryPage"
             Title="Available Cats"
             BackgroundColor="{StaticResource White}">
    <Grid RowDefinitions="Auto,*" Padding="0">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,12" BackgroundColor="{StaticResource White}">
            <Border Grid.Column="0" Padding="15,0" Stroke="{StaticResource Gray200}" StrokeShape="RoundRectangle 20" HeightRequest="46">
                <Entry Text="{Binding SearchText, Mode=TwoWay}" 
                       Placeholder="Search by name" 
                       PlaceholderColor="Black" 
                       TextChanged="OnSearchTextChanged" 
                       VerticalOptions="Center" 
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       FontSize="16" 
                       BackgroundColor="Transparent" 
                       TextColor="Black"/>
            </Border>

            <Button Grid.Column="1" Text="Filters" 
                    Clicked="OnFiltersClicked" 
                    BackgroundColor="{StaticResource Primary}" 
                    TextColor="{StaticResource White}"
                    CornerRadius="23" 
                    HeightRequest="46"
                    WidthRequest="90"
                    FontSize="16"
                    Margin="10,0,0,0" />
            <!--Test
            <Button Grid.Column="1" 
                    Text="Test Filter" 
                    Clicked="OnTestFilterClicked" 
                    BackgroundColor="#3c7f76" 
                    TextColor="{StaticResource White}"
                    CornerRadius="23" 
                    HeightRequest="46"
                    WidthRequest="90"
                    FontSize="16"
                    Margin="10,0,0,0"
                    IsVisible="{OnPlatform Android=true, Default=false}" />
            -->
        </Grid>

        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding FilteredCats}" 
                               SelectionMode="None"
                               x:Name="CatsCollectionView"
                               RemainingItemsThreshold="2"
                               RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" 
                                         Span="2" 
                                         HorizontalItemSpacing="12" 
                                         VerticalItemSpacing="16" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Grid>
                            <StackLayout x:Name="LoadingView" 
                                         IsVisible="{Binding IsLoading}"
                                         VerticalOptions="Center" 
                                         HorizontalOptions="Center" 
                                         Spacing="15">
                                <ActivityIndicator IsRunning="True" 
                                                   Color="{StaticResource Primary}" 
                                                   Scale="1.5"
                                                   HeightRequest="50"
                                                   WidthRequest="50" />
                                <Label Text="Loading cats..." 
                                       TextColor="{StaticResource Primary}" 
                                       FontSize="16"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>

                            <StackLayout x:Name="NoCatsFoundView"
                                         IsVisible="{Binding ShowNoResultsMessage}"
                                         VerticalOptions="Center" 
                                         HorizontalOptions="Center" 
                                         Padding="20">
                                <Label Text="{Binding NoResultsMessage}" 
                                       TextColor="Black" 
                                       FontSize="18" 
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Try adjusting your search or filters" 
                                       TextColor="Gray" 
                                       FontSize="14" 
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Grid>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,4" RowDefinitions="Auto,Auto" IsClippedToBounds="False">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CatSelectedCommand}" 
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Border Grid.Row="0" Padding="0" Stroke="{StaticResource Gray200}" StrokeShape="RoundRectangle 12" StrokeThickness="1" 
                                       HeightRequest="180">
                                    <Image Source="{Binding CoverPhoto}" Aspect="AspectFill" />
                                </Border>

                                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                                    <Label Grid.Row="0" Text="{Binding Name}" 
                                           FontSize="18" FontAttributes="Bold" 
                                           TextColor="Black" LineBreakMode="TailTruncation"
                                           HorizontalOptions="Start" />

                                    <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="4">
                                        <Label Text="{Binding Sex}" FontSize="14"/>
                                        <Label Text=" • " FontSize="14" TextColor="Gray"/>
                                        <Label Text="{Binding AgeDisplay}" FontSize="14" TextColor="Black" />
                                    </StackLayout>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <StackLayout IsVisible="{Binding HasError}" 
                         VerticalOptions="Center" 
                         HorizontalOptions="Center"
                         Padding="20">
                <Label Text="{Binding ErrorMessage}" 
                       TextColor="Red" 
                       HorizontalTextAlignment="Center"
                       FontSize="16" />
                <Button Text="Retry" 
                        Command="{Binding RefreshCommand}"
                        HorizontalOptions="Center"
                        Margin="0,16,0,0"
                        CornerRadius="20"
                        WidthRequest="120"
                        HeightRequest="44" />
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>