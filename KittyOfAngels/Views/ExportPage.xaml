<?xml version="1.0" encoding="utf-8" ?>
<!--Version 1.0-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KittyOfAngels.ViewModels"
             xmlns:models="clr-namespace:KittyOfAngels.Models"
             xmlns:converters="clr-namespace:KittyOfAngels.Converters"
             x:Class="KittyOfAngels.Views.ExportPage"
             x:DataType="viewmodels:ExportViewModel"
             BackgroundColor="White"
             Title="Export">

    <ContentPage.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20">
        <Label Text="Export Available Cats" 
               Grid.Row="0"
               FontSize="24" 
               FontAttributes="Bold"
               TextColor="Black"
               HorizontalOptions="Center" 
               Margin="0,10,0,20" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <Entry x:Name="SearchEntry"
                   Placeholder="Search cats by name..."
                   PlaceholderColor="Black"
                   TextColor="Black"
                   Grid.Column="0"
                   HorizontalOptions="Fill"
                   Text="{Binding SearchText, Mode=TwoWay}" />
        </Grid>

        <CollectionView Grid.Row="2" 
                        ItemsSource="{Binding FilteredCats}">
            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="No cats found" 
                           TextColor="Black"
                           FontSize="18" 
                           HorizontalTextAlignment="Center" />
                </StackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CatItem">
                    <Border StrokeShape="RoundRectangle 8" 
                           Stroke="#DDDDDD"
                           Background="White"
                           Margin="0,5" 
                           Padding="10">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <Image Grid.Column="0" 
                                   Grid.RowSpan="4" 
                                   Source="{Binding CoverPhoto}" 
                                   WidthRequest="80" 
                                   HeightRequest="80"
                                   Aspect="AspectFill"
                                   Margin="0,0,10,0" />

                            <Label Grid.Column="1" Grid.Row="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="18" TextColor="Black" />
                            <Label Grid.Column="1" Grid.Row="1" Text="{Binding Breed}" TextColor="Black" />
                            <Label Grid.Column="1" Grid.Row="2" Text="{Binding Sex, StringFormat='Sex: {0}'}" TextColor="Black" />
                            <Label Grid.Column="1" Grid.Row="3" Text="{Binding AgeDisplay, StringFormat='Age: {0}'}" TextColor="Black" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--Comment out during test-->
        <Button Grid.Row="3" 
                Text="Export to CSV"
                FontAttributes="Bold"
                Command="{Binding ExportCommand}"
                TextColor="#FFFFFF"
                BackgroundColor="#4FBBB2"
                Margin="0,10,0,0" />

        <!--Comment out for release
        <Button Grid.Row="3" 
                Text="Test Search Filter" 
                Clicked="OnTestSearchFilterClicked"
                BackgroundColor="#3c7f76" 
                TextColor="#FFFFFF"
                CornerRadius="8" 
                FontSize="14"
                Margin="0,60,0,0"
                IsVisible="{OnPlatform Android=true, Default=false}" />
        -->

        <ActivityIndicator Grid.RowSpan="4" 
                          IsRunning="{Binding IsLoading}" 
                          IsVisible="{Binding IsLoading}"
                          Color="#4FBBB2"
                          HorizontalOptions="Center" 
                          VerticalOptions="Center" />

        <Label Grid.Row="2" 
               Text="{Binding ErrorMessage}" 
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
               TextColor="Red" 
               VerticalOptions="Center"
               HorizontalOptions="Center" />
    </Grid>
</ContentPage>