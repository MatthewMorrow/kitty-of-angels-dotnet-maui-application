<?xml version="1.0" encoding="utf-8" ?>
<!--Version 1.0-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KittyOfAngels.Views.CatProfilePage"
             Title="Cat Profile"
             BackgroundColor="{StaticResource White}">
    <Grid>
        <ActivityIndicator IsRunning="{Binding IsLoading}" 
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"
                           Color="{StaticResource Primary}" />

        <StackLayout IsVisible="{Binding HasError}" 
                     VerticalOptions="Center" 
                     HorizontalOptions="Center"
                     Padding="20">
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red" 
                   HorizontalTextAlignment="Center" />
            <Button Text="Retry" 
                    Command="{Binding LoadCatCommand}"
                    HorizontalOptions="Center"
                    Margin="0,10,0,0" />
        </StackLayout>

        <ScrollView IsVisible="{Binding IsContentVisible}">
            <StackLayout Padding="0,0,0,20">
                <CarouselView ItemsSource="{Binding Cat.Photos}" 
                              IndicatorView="indicatorView"
                              HeightRequest="450"
                              Loop="True">
                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Image Source="{Binding .}" 
                                       Aspect="AspectFill"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />
                            </Grid>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

                <IndicatorView x:Name="indicatorView"
                                HorizontalOptions="Center"
                                Margin="0,15,0,10"
                                IndicatorColor="Gray"
                                IndicatorSize="8"
                                SelectedIndicatorColor="{StaticResource Primary}" />

                <StackLayout Padding="15,0,15,5">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding Cat.Name}" 
                               FontSize="26" 
                               FontAttributes="Bold" 
                               TextColor="Black" />

                        <Border Grid.Column="1"
                               Background="{StaticResource Primary}"
                               StrokeShape="RoundRectangle 12"
                               Padding="16,6">
                            <Label Text="{Binding Cat.Status}"
                                   TextColor="White" 
                                   FontSize="14" 
                                   FontAttributes="Bold" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                        <Label Grid.Column="0" Text="{Binding Cat.Sex}" TextColor="Black" FontSize="14" />
                        <Label Grid.Column="1" Text="{Binding Cat.Breed}" TextColor="Black" HorizontalOptions="Center" FontSize="14" />
                        <Label Grid.Column="2" Text="{Binding Cat.AgeDisplay}" TextColor="Black" FontSize="14"  />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,15,0,15" />
                </StackLayout>

                <StackLayout Padding="16,0">
                    <Label Text="Attributes" FontSize="18" FontAttributes="Bold" TextColor="Black" Margin="0,0,0,10" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding DisplayAttributes}"
                                Wrap="Wrap"
                                JustifyContent="Start"
                                AlignItems="Start"
                                AlignContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F0F0F0" 
                                       Stroke="Transparent"
                                       StrokeShape="RoundRectangle 8" 
                                       Padding="10,5"
                                       Margin="0,0,8,8">
                                    <Label Text="{Binding .}" 
                                           TextColor="Black" 
                                           FontSize="14" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,15,0,15" />
                </StackLayout>

                <StackLayout Padding="16,0">
                    <Label Text="About" FontSize="18" FontAttributes="Bold" TextColor="Black" Margin="0,0,0,10" />
                    <Label Text="{Binding Cat.Description}" 
                           TextColor="Black" 
                           FontSize="14"
                           LineBreakMode="WordWrap" />
                </StackLayout>

                <StackLayout Padding="16,20,16,0" Spacing="10">
                    <Button Text="Apply to Adopt" 
                            BackgroundColor="{StaticResource Primary}" 
                            TextColor="White" 
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="25"
                            HeightRequest="50"
                            Command="{Binding ApplyToAdoptCommand}" />

                    <Button Text="Contact Kitty of Angels" 
                            BackgroundColor="Transparent" 
                            TextColor="Black" 
                            BorderColor="{StaticResource Primary}"
                            FontSize="16"
                            BorderWidth="1"
                            FontAttributes="Bold"
                            CornerRadius="25"
                            HeightRequest="50"
                            Command="{Binding ContactCommand}" />
                </StackLayout>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>